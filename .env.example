DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sales_agent
JWT_SECRET=change-this-in-production
JWT_ISSUER=sales-sync-api
JWT_AUDIENCE=sales-sync-web
APP_ENV=development
# Use none only for HTTPS deployments with frontend/API on different sites.
REFRESH_COOKIE_SAMESITE=lax
BACKEND_URL=http://localhost:8000
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000","https://frontend-vrdj.vercel.app"]
UPSTASH_REDIS_REST_URL=
# Optional native Redis connection; takes priority over Upstash when set.
REDIS_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. If omitted, onboarding uses a deterministic local ICP fallback.
GROK_API_KEY=

# Google OAuth (required for Gmail integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Social login credentials (separate from Gmail integration).
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_PUBLIC_BASE_URL=http://localhost:5173/api
OAUTH_FRONTEND_URL=http://localhost:5173

# Stripe (required for billing)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_GROWTH_PRICE=
STRIPE_ENTERPRISE_PRICE=

# Reserved for future integrations.
APOLLO_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=
